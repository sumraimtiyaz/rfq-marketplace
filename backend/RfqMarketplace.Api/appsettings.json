{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=rfq_marketplace;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "RfqMarketplace",
    "Audience": "RfqMarketplaceClient",
    "Key": "",
    "ExpiryMinutes": 480,
    "CookieName": "rfq_token",
    "CookieSecure": true,
    "CookieSameSite": "Lax",
    "CookieDomain": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": true
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
