# ---------------------------------------------------------------------------
# Copy to .env before running `docker compose up`. Docker Compose reads .env
# automatically; nothing here is read by the apps when you run them directly.
# ---------------------------------------------------------------------------

# Signing key for the JWT. REQUIRED - compose refuses to start without it.
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=replace-this-with-a-long-random-string-at-least-32-chars

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rfq_marketplace

# Host ports. Change any that are already in use on your machine - the containers
# always talk to each other on their internal ports, so this only affects your access.
# 5434 rather than 5432 because a locally installed PostgreSQL usually holds 5432 already;
# it also matches the default in backend/RfqMarketplace.Api/appsettings.json.
POSTGRES_PORT=5434
API_PORT=5080
FRONTEND_PORT=3000

# Cookie flags. Secure=false is required for plain-HTTP localhost; set it to true
# in any deployment served over HTTPS.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Serve Swagger UI at /swagger, and load the demo buyers, suppliers and RFQs on
# first start. Turn both off for a real production deployment.
SWAGGER_ENABLED=true
SEED_DEMO_DATA=true

ASPNETCORE_ENVIRONMENT=Production
